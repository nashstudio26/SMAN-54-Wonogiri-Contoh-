    /* =========================================================================
       3. SLIDESHOW HERO BACKGROUND (2 FOTO BERGANTIAN SETIAP 3,5 DETIK)
       ========================================================================= */
    function initHeroSlideshow() {
      const slide1 = document.getElementById('hero-slide-1');
      const slide2 = document.getElementById('hero-slide-2');
      const dot1 = document.getElementById('hero-dot-1');
      const dot2 = document.getElementById('hero-dot-2');
      let currentSlide = 1;

      setInterval(() => {
        if (currentSlide === 1) {
          slide1.classList.remove('active');
          slide2.classList.add('active');
          if (dot1 && dot2) {
            dot1.className = "w-3 h-1 bg-white/40 transition-all";
            dot2.className = "w-8 h-1 bg-white transition-all";
          }
          currentSlide = 2;
        } else {
          slide2.classList.remove('active');
          slide1.classList.add('active');
          if (dot1 && dot2) {
            dot2.className = "w-3 h-1 bg-white/40 transition-all";
            dot1.className = "w-8 h-1 bg-white transition-all";
          }
          currentSlide = 1;
        }
      }, 3500);
    }

    /* =========================================================================
       4. EFEK FADE IN RINGAN SAAT SCROLL (TIDAK MEMBEBANI LOAD PERTAMA)
       ========================================================================= */
    function initFadeAnimation() {
      const sections = document.querySelectorAll('.fade-section');
      const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.remove('pending-fade');
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          }
        });
      }, {
        threshold: 0.08,
        rootMargin: '0px 0px -40px 0px'
      });

      sections.forEach(sec => {
        // Hanya elemen di luar viewport awal yang diberi pending-fade
        const rect = sec.getBoundingClientRect();
        if (rect.top > window.innerHeight) {
          sec.classList.add('pending-fade');
          observer.observe(sec);
        } else {
          sec.classList.add('is-visible');
        }
      });
    }

