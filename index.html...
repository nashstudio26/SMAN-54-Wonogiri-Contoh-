                <span class="text-[11px] text-amber-700 font-bold uppercase tracking-wider">${item.tanggal || 'Prestasi 2026'}</span>
                <h3 class="font-bold text-slate-900 text-base leading-snug group-hover:text-amber-600 transition line-clamp-2">
                  ${item.judul}
                </h3>
                <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                  ${item.ringkasan || item.isi_artikel}
                </p>
              </div>
              <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-amber-700">
                <span>Rincian Capaian</span>
                <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
              </div>
            </div>
          </div>
        `).join('');
      }

      if (containerAll) {
        containerAll.innerHTML = prestasiList.map(item => `
          <div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-lg border border-amber-200/80 flex flex-col transition-all duration-200 group cursor-pointer" onclick="openPrestasiDetail('${item.id}')">
            <div class="relative h-56 overflow-hidden bg-slate-900">
              <img src="${formatDriveUrl(item.foto_url)}" alt="${item.judul}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" onerror="this.src='https://via.placeholder.com/600x400?text=Prestasi+Siswa'" />
              <div class="absolute top-3 right-3 bg-amber-500 text-slate-900 text-xs font-black px-3 py-1 rounded shadow">
                Juara
              </div>
            </div>
            <div class="p-6 flex-1 flex flex-col justify-between space-y-3">
              <div class="space-y-2">
                <span class="text-xs text-amber-700 font-bold uppercase tracking-wider">${item.tanggal || 'Prestasi'}</span>
                <h3 class="font-bold text-slate-900 text-base group-hover:text-amber-600 transition">
                  ${item.judul}
                </h3>
                <p class="text-xs text-slate-500 line-clamp-3 leading-relaxed">
                  ${item.ringkasan || item.isi_artikel}
                </p>
              </div>
              <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-amber-700">
                <span>Lihat Detail Capaian</span>
                <i class="fa-solid fa-arrow-right"></i>
              </div>
            </div>
          </div>
        `).join('');
      }
    }

    // Render Guru & Tenaga Kependidikan (GTK: Default 5 Orang, Expand to 22)
    function renderGTK() {
      const container = document.getElementById('gtk-grid');
      if (!container) return;

      const listToRender = appState.gtkExpanded ? appState.gtk : appState.gtk.slice(0, 5);

      container.innerHTML = listToRender.map(guru => `
        <div class="bg-white p-4 rounded-xl border border-slate-200/80 text-center shadow-sm hover:shadow-md transition-all group">
          <div class="w-20 h-20 sm:w-24 sm:h-24 mx-auto rounded-full overflow-hidden mb-3 bg-slate-100 border-2 border-slate-100 group-hover:border-brand-500 transition-colors">
            <img src="${formatDriveUrl(guru.foto_url, 'https://lh3.googleusercontent.com/d/1Rr1M9Wz5Z9LIQmuQnLql4ra0E_TcBINu')}" alt="${guru.nama}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200" onerror="this.src='https://lh3.googleusercontent.com/d/1Rr1M9Wz5Z9LIQmuQnLql4ra0E_TcBINu'" />
          </div>
          <h4 class="font-bold text-slate-800 text-xs sm:text-sm line-clamp-2 leading-tight">${guru.nama}</h4>
          <p class="text-[10px] sm:text-[11px] text-brand-600 font-medium mt-1 line-clamp-2">${guru.jabatan}</p>
        </div>
      `).join('');
    }

    function toggleGTKView() {
      appState.gtkExpanded = !appState.gtkExpanded;
      renderGTK();

      const btnText = document.getElementById('gtk-btn-text');
      const btnIcon = document.getElementById('gtk-btn-icon');

      if (appState.gtkExpanded) {
        btnText.innerText = "Tampilkan Lebih Sedikit (5 Guru)";
        btnIcon.className = "fa-solid fa-chevron-up text-[10px]";
      } else {
        btnText.innerText = "Lihat Selengkapnya (22 GTK)";
        btnIcon.className = "fa-solid fa-chevron-down text-[10px]";
      }
    }

    // Render Galeri
    function renderGaleri() {
      const container = document.getElementById('galeri-grid');
      if (!container) return;

      container.innerHTML = appState.galeri.map(item => `
        <div class="relative rounded-xl overflow-hidden shadow-sm group cursor-pointer bg-slate-900 h-52 sm:h-64" onclick="openGaleriModal('${item.id}')">
          <img src="${formatDriveUrl(item.foto_url)}" alt="${item.judul}" class="w-full h-full object-cover group-hover:scale-105 opacity-85 group-hover:opacity-75 transition-all duration-300" onerror="this.src='https://via.placeholder.com/600x400?text=Galeri+SMAN54'" />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/25 to-transparent p-4 flex flex-col justify-end text-white">
            <span class="text-[10px] text-amber-400 font-semibold mb-1">${item.tanggal || 'Dokumentasi'}</span>
            <h4 class="font-bold text-xs sm:text-sm line-clamp-2 group-hover:text-amber-300 transition">${item.judul}</h4>
          </div>
        </div>
      `).join('');
    }

    // Render Kepala Sekolah
    function renderKepalaSekolah() {
      const ks = appState.kepala_sekolah[0];
      if (!ks) return;
      if (document.getElementById('ks-nama')) document.getElementById('ks-nama').innerText = ks.nama || "Drs. H. Suwito, M.Pd.";
      if (document.getElementById('ks-jabatan')) document.getElementById('ks-jabatan').innerText = ks.jabatan || "SMA Negeri 54 Wonogiri";
      if (document.getElementById('ks-judul')) document.getElementById('ks-judul').innerText = ks.judul_sambutan || "Membangun Generasi Emas yang Beradab dan Berprestasi";
      if (document.getElementById('ks-isi')) {
        const paragraphs = (ks.isi_sambutan || "").split('\n\n');
        document.getElementById('ks-isi').innerHTML = paragraphs.map(p => `<p>${p}</p>`).join('');
      }
      if (document.getElementById('ks-foto') && ks.foto_url) {
        document.getElementById('ks-foto').src = formatDriveUrl(ks.foto_url);
      }
    }

    /* =========================================================================
       6. INTEGRASI LIVE FETCH SHEETDB API (CRUD SUPPORT)
       ========================================================================= */
    async function fetchSheetData(sheetName) {
      try {
        const response = await fetch(`${SHEETDB_BASE_URL}?sheet=${sheetName}`, {
          method: 'GET',
          headers: { 'Accept': 'application/json' }
        });
        if (!response.ok) return null;
        const data = await response.json();
        return Array.isArray(data) && data.length > 0 ? data : null;
      } catch (err) {
        console.warn(`Gagal mengambil data sheet ${sheetName}:`, err);
        return null;
      }
    }

    async function loadAllSpreadsheetData() {
      const [resKS, resBerita, resPrestasi, resGaleri, resGTK] = await Promise.allSettled([
        fetchSheetData('kepala_sekolah'),
        fetchSheetData('berita'),
        fetchSheetData('prestasi'),
        fetchSheetData('galeri'),
        fetchSheetData('gtk')
      ]);

      if (resKS.status === 'fulfilled' && resKS.value) appState.kepala_sekolah = resKS.value;
      if (resBerita.status === 'fulfilled' && resBerita.value) appState.berita = resBerita.value;
      if (resPrestasi.status === 'fulfilled' && resPrestasi.value) appState.prestasi = resPrestasi.value;
      if (resGaleri.status === 'fulfilled' && resGaleri.value) appState.galeri = resGaleri.value;
      if (resGTK.status === 'fulfilled' && resGTK.value) appState.gtk = resGTK.value;

      renderKepalaSekolah();
      renderBerita();
      renderPrestasi();
      renderGTK();
      renderGaleri();
    }

    /* =========================================================================
       7. SPA ROUTING & DETAIL ARTICLE / DYNAMIC PAGE LOGIC
       ========================================================================= */
    function hideAllViews() {
      document.querySelectorAll('.view-page').forEach(view => {
        view.classList.add('hidden');
        view.classList.remove('block');
      });
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function navigateTo(viewName) {
      hideAllViews();
      if (viewName === 'home') {
        document.getElementById('view-home').classList.remove('hidden');
        document.getElementById('view-home').classList.add('block');
      } else if (viewName === 'all-berita') {
        document.getElementById('view-all-berita').classList.remove('hidden');
        document.getElementById('view-all-berita').classList.add('block');
        renderBerita();
      } else if (viewName === 'all-prestasi') {
        document.getElementById('view-all-prestasi').classList.remove('hidden');
        document.getElementById('view-all-prestasi').classList.add('block');
        renderPrestasi();
      }
      closeMobileMenu();
    }

    function scrollToSection(sectionId) {
      if (document.getElementById('view-home').classList.contains('hidden')) {
        navigateTo('home');
        setTimeout(() => {
          const el = document.getElementById(sectionId);
          if (el) el.scrollIntoView({ behavior: 'smooth' });
        }, 100);
      } else {
        const el = document.getElementById(sectionId);
        if (el) el.scrollIntoView({ behavior: 'smooth' });
      }
      closeMobileMenu();
    }

    function openBeritaDetail(beritaId) {
      const item = appState.berita.find(b => String(b.id) === String(beritaId)) || appState.berita[0];
      if (!item) return;

      document.getElementById('detail-berita-judul').innerText = item.judul;
      document.getElementById('detail-berita-tanggal').innerText = item.tanggal || 'Terbaru';
      document.getElementById('detail-berita-penulis').innerText = item.penulis || 'Admin SMAN 54';
      document.getElementById('detail-berita-foto').src = formatDriveUrl(item.foto_url);
      document.getElementById('detail-berita-isi').innerText = item.isi_artikel || item.ringkasan || "Konten sedang diperbarui...";

      hideAllViews();
      document.getElementById('view-berita-detail').classList.remove('hidden');
      document.getElementById('view-berita-detail').classList.add('block');
    }

    function openPrestasiDetail(prestasiId) {
      const item = appState.prestasi.find(p => String(p.id) === String(prestasiId)) || appState.prestasi[0];
      if (!item) return;

      document.getElementById('detail-berita-kategori').innerText = "Prestasi Siswa";
      document.getElementById('detail-berita-judul').innerText = item.judul;
      document.getElementById('detail-berita-tanggal').innerText = item.tanggal || 'Prestasi';
      document.getElementById('detail-berita-penulis').innerText = item.penulis || 'SMAN 54 Wonogiri';
      document.getElementById('detail-berita-foto').src = formatDriveUrl(item.foto_url);
      document.getElementById('detail-berita-isi').innerText = item.isi_artikel || item.ringkasan || "Rincian prestasi sedang diverifikasi...";

      hideAllViews();
      document.getElementById('view-berita-detail').classList.remove('hidden');
      document.getElementById('view-berita-detail').classList.add('block');
    }

    function loadDynamicPage(pageKey) {
      const page = defaultData.dynamic_pages[pageKey];
      if (!page) return;

      document.getElementById('dyn-badge').innerText = page.badge;
      document.getElementById('dyn-title').innerText = page.title;
      document.getElementById('dyn-content').innerText = page.content;

      const imgContainer = document.getElementById('dyn-image-container');
      const imgEl = document.getElementById('dyn-image');
      if (page.image && page.image.trim() !== "") {
        imgEl.src = formatDriveUrl(page.image);
        imgContainer.classList.remove('hidden');
      } else {
        imgContainer.classList.add('hidden');
      }

      hideAllViews();
      document.getElementById('view-dynamic-page').classList.remove('hidden');
      document.getElementById('view-dynamic-page').classList.add('block');
      closeMobileMenu();
    }

    /* =========================================================================
       8. MODAL GALERI POPUP INTERAKTIF
       ========================================================================= */
    function openGaleriModal(galeriId) {
      const item = appState.galeri.find(g => String(g.id) === String(galeriId)) || appState.galeri[0];
      if (!item) return;

      document.getElementById('modal-foto').src = formatDriveUrl(item.foto_url);
      document.getElementById('modal-judul').innerText = item.judul;
      document.getElementById('modal-deskripsi').innerText = item.deskripsi_singkat || "Dokumentasi kegiatan siswa-siswi SMAN 54 Wonogiri.";
      document.getElementById('modal-tanggal').innerText = item.tanggal || "Dokumentasi";
      document.getElementById('modal-penulis').innerText = item.penulis || "Tim Media";

      const modal = document.getElementById('modal-galeri');
      const card = document.getElementById('modal-galeri-card');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      setTimeout(() => {
        card.classList.remove('scale-95', 'opacity-0');
        card.classList.add('scale-100', 'opacity-100');
      }, 10);
    }

    function closeGaleriModal() {
      const modal = document.getElementById('modal-galeri');
      const card = document.getElementById('modal-galeri-card');
      card.classList.remove('scale-100', 'opacity-100');
      card.classList.add('scale-95', 'opacity-0');
      setTimeout(() => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }, 200);
    }

    document.getElementById('modal-galeri').addEventListener('click', (e) => {
      if (e.target.id === 'modal-galeri') closeGaleriModal();
    });

    /* =========================================================================
       9. RESPONSIVE MOBILE MENU
       ========================================================================= */
    function toggleMobileMenu() {
      const menu = document.getElementById('mobile-menu');
      const icon = document.getElementById('hamburger-icon');
      if (menu.classList.contains('hidden')) {
        menu.classList.remove('hidden');
        icon.className = "fa-solid fa-xmark text-2xl text-slate-800";
      } else {
        menu.classList.add('hidden');
        icon.className = "fa-solid fa-bars text-2xl text-slate-800";
      }
    }

    function closeMobileMenu() {
      const menu = document.getElementById('mobile-menu');
      const icon = document.getElementById('hamburger-icon');
      if (menu) menu.classList.add('hidden');
      if (icon) icon.className = "fa-solid fa-bars text-2xl text-slate-800";
    }

    function toggleMobileDropdown(dropdownId) {
      const dd = document.getElementById(dropdownId);
      if (!dd) return;
      dd.classList.toggle('hidden');
    }

    function mobileNavigateTo(viewName) {
      navigateTo(viewName);
      closeMobileMenu();
    }

    function mobileNavigateToSection(sectionId) {
      scrollToSection(sectionId);
      closeMobileMenu();
    }

    function mobileLoadPage(pageKey) {
      loadDynamicPage(pageKey);
      closeMobileMenu();
    }

    /* =========================================================================
       10. FORM SUBMISSION KE WHATSAPP & SCROLL TOP
       ========================================================================= */
    function handleContactSubmit(e) {
      e.preventDefault();
      const name = document.getElementById('contact-name').value;
      const msg = document.getElementById('contact-msg').value;
      const text = `Halo SMAN 54 Wonogiri,%0ASaya: ${encodeURIComponent(name)}%0APesan: ${encodeURIComponent(msg)}`;
      window.open(`https://wa.me/6285640366256?text=${text}`, '_blank');
    }

    window.addEventListener('scroll', () => {
      const btn = document.getElementById('btn-scroll-top');
      if (window.scrollY > 400) {
        btn.classList.remove('opacity-0', 'pointer-events-none');
        btn.classList.add('opacity-100', 'pointer-events-auto');
      } else {
        btn.classList.add('opacity-0', 'pointer-events-none');
        btn.classList.remove('opacity-100', 'pointer-events-auto');
      }
    });

    /* =========================================================================
       11. INISIALISASI INSTAN KETIKA HALAMAN DIMUAT
       ========================================================================= */
    window.addEventListener('DOMContentLoaded', () => {
      // Render instan konten default agar tidak ada jeda 1 detik
      renderKepalaSekolah();
      renderBerita();
      renderPrestasi();
      renderGTK();
      renderGaleri();

      // Jalankan animasi hero & intersection observer ringan
      initHeroSlideshow();
      initFadeAnimation();

      // Sinkronisasi data live dari SheetDB
      loadAllSpreadsheetData();
    });
  </script>

</body>
